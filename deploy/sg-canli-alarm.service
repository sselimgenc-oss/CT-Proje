# sg-canli düşünce (OnFailure) bir kez çalışır: Telegram'a kısa alarm. Token/chat YALNIZ /etc/sg-canli-telegram.env içinden (G-22: HL anahtarı bu birime YÜKLENMEZ); yoksa "atlandı" yazıp 0 ile biter.
[Unit]
Description=sg-arge canli motor alarmi (OnFailure)

[Service]
Type=oneshot
User=sgcanli
Group=sgcanli
EnvironmentFile=-/etc/sg-canli-telegram.env
ExecStart=/bin/bash /opt/sg-arge/deploy/alarm.sh sg-canli
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
