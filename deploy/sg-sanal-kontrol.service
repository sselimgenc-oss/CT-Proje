# Sanal açılış kontrolü (emir göndermez; anahtar yok): HL bağlantısı, kadro okuma, durum dizini. Rapor günlüğe: journalctl -u sg-sanal-kontrol -o cat. `tamam: false` ise servis "failed" görünür.
# Not: motor ÇALIŞIRKEN de çalıştırılabilir (yalnız okur; kontrol.json yazar). Telegram tokeni tanımlıysa bir deneme mesajı gitmez (yalnız gerçek kipte gider).
[Unit]
Description=sg-arge sanal motor acilis kontrolu (emir gondermez)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sgsanal
Group=sgsanal
WorkingDirectory=/var/lib/sg-sanal/depo
EnvironmentFile=/etc/sg-sanal-mod.env
Environment=HOME=/var/lib/sg-sanal
ExecStart=/var/lib/sg-sanal/venv/bin/python -u -m copytrade.canli.motor --kontrol --kip sanal --sanal-kasa-usd 1000 --kadro-dali ${KADRO_DALI} --durum-dizin durum --rapor kontrol.json
# Kaynak sınırı
MemoryMax=400M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sg-sanal
